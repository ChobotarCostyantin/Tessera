# Copy this file to .env and fill in values for local development.
# .env is git-ignored and never committed.

# App
PORT=3010

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=tessera

DATABASE_URL=postgresql://root:password@localhost:5432/tessera?schema=public

# CORS (comma-separated list of URLs)
FRONTEND_URL=http://localhost:3000