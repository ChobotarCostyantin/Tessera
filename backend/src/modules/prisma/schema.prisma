generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Portfolio {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  isPublished Boolean  @default(false)
  pageConfig  Json     @default("{}")
  ownerToken  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerToken])
}